# API base for the Next.js backend
# Local LAN example:
# EXPO_PUBLIC_API_BASE=http://192.168.1.66:3000/api
#
# Production example:
# EXPO_PUBLIC_API_BASE=https://ivantaproperty.com/api
EXPO_PUBLIC_API_BASE=

# Set to true to run the app without backend/MongoDB (uses built-in demo properties)
EXPO_PUBLIC_DEMO_MODE=false
